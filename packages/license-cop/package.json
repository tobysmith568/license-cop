{
  "name": "license-cop",
  "version": "0.0.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "license-cop": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test --isolate --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "version": "bun pm pkg set version=$VERSION",
    "pack": "bun pm pack",
    "publish": "npm publish *.tgz --access public --provenance --tag $NPM_TAG"
  },
  "author": {
    "name": "Toby Smith",
    "email": "contact@tobythe.dev",
    "url": "https://tobysmith.uk"
  },
  "license": "ISC",
  "description": "Yet another license checker tool for your dependencies; focused on simplicity.",
  "homepage": "https://license-cop.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysmith568/license-cop.git",
    "directory": "packages/license-cop"
  },
  "bugs": {
    "url": "https://github.com/tobysmith568/license-cop/issues"
  },
  "keywords": [
    "cli",
    "license",
    "licenses",
    "license-cop",
    "spdx",
    "dependencies",
    "oss"
  ],
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@npmcli/arborist": "^9.0.0",
    "@pnpm/reviewing.dependencies-hierarchy": "^1001.0.0",
    "axios": "^1.6.0",
    "commander": "^14.0.0",
    "compare-versions": "^6.0.0-rc.1",
    "cosmiconfig": "^9.0.0",
    "deepmerge": "^4.3.1",
    "git-filesystem": "^0.0.6",
    "json5": "^2.2.3",
    "zod": "^4.0.0"
  }
}
