{
  "name": "@license-cop/permissive",
  "version": "0.0.0",
  "type": "commonjs",
  "main": "./.licenses.jsonc",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test --isolate --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "version": "bun pm pkg set version=$VERSION",
    "pack": "bun pm pack",
    "publish": "npm publish *.tgz --access public --provenance --tag $NPM_TAG"
  },
  "author": {
    "name": "Toby Smith",
    "email": "contact@tobythe.dev",
    "url": "https://tobysmith.uk"
  },
  "license": "ISC",
  "description": "An out-of-the-box base config file for license-cop containing a curated list of especially permissive licenses.",
  "homepage": "https://license-cop.js.org/permissive",
  "files": [
    ".licenses.jsonc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysmith568/license-cop.git",
    "directory": "packages/permissive"
  },
  "bugs": {
    "url": "https://github.com/tobysmith568/license-cop/issues"
  },
  "keywords": [
    "cli",
    "license",
    "licenses",
    "license-cop",
    "spdx",
    "dependencies",
    "oss"
  ]
