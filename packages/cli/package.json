{
  "name": "license-cop",
  "version": "0.0.0",
  "type": "commonjs",
  "bin": {
    "license-cop": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test --isolate --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "version": "bun pm pkg set version=$VERSION",
    "pack": "bun pm pack",
    "publish": "npm publish *.tgz --access public --provenance --tag $NPM_TAG"
  },
  "author": {
    "name": "Toby Smith",
    "email": "contact@tobythe.dev",
    "url": "https://tobysmith.uk"
  },
  "license": "ISC",
  "description": "Yet another license checker tool for your dependencies; focused on simplicity.",
  "homepage": "https://license-cop.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysmith568/license-cop.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tobysmith568/license-cop/issues"
  },
  "keywords": [
    "cli",
    "license",
    "licenses",
    "license-cop",
    "spdx",
    "dependencies",
    "oss"
  ],
  "dependencies": {
    "@license-cop/core": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@license-cop/test-utils": "workspace:*"
  }
}
