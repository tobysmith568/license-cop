{
  "name": "license-cop-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/license-cop-e2e/src",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings 0",
        "cwd": "packages/license-cop-e2e"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "bun test --isolate --timeout=60000 packages/license-cop-e2e/src"
      },
      "configurations": {
        "ci": {
          "command": "bun test --isolate --timeout=60000 --coverage --coverage-reporter=lcov --coverage-dir=coverage/packages/license-cop-e2e packages/license-cop-e2e/src"
        }
      }
    }
  },
  "tags": [],
  "implicitDependencies": ["e2e-*", "license-cop"]
}
