{
  "name": "cli-e2e",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@license-cop/e2e-fixtures": "workspace:*",
    "@license-cop/test-utils": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "e2e": "bun test --isolate --timeout=60000 --coverage --coverage-reporter=lcov --coverage-dir=coverage src"
  }
}
